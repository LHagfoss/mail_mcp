# Copy to .env and fill in (never commit real creds)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# Sending/replying is disabled unless explicitly enabled. Tool calls also require confirm_send=true.
MAIL_SMTP_WRITE_ENABLED=false
# IMAP mailbox changes (flags, move, trash) are independently disabled by default.
MAIL_IMAP_WRITE_ENABLED=false
# Attachment files can only be read/written beneath this root (default: ./attachments).
MAIL_ATTACHMENT_ROOT=attachments
# Per-file attachment limit (default: 25 MiB).
MAIL_MAX_ATTACHMENT_BYTES=26214400
# Combined outgoing attachment limit (default: 25 MiB).
MAIL_MAX_TOTAL_ATTACHMENT_BYTES=26214400
# Maximum raw message size read for bodies/attachments (default: 50 MiB).
MAIL_MAX_EMAIL_BYTES=52428800
# IMAP folder for copies of successfully sent messages. one.com uses INBOX.Sent.
# MAIL_SENT_FOLDER=INBOX.Sent
# IMAP folder used by trash_email (default: Trash; provider-specific).
# MAIL_TRASH_FOLDER=INBOX.Trash

# Other providers:
# Outlook: imap outlook.office365.com:993 / smtp smtp.office365.com:587
# Yahoo:   imap imap.mail.yahoo.com:993
# Fastmail: imap imap.fastmail.com:993 / smtp smtp.fastmail.com:587
# Zoho:    imap imap.zoho.com:993 / smtp smtp.zoho.com:587
# iCloud:  imap imap.mail.me.com:993 / smtp smtp.mail.me.com:587
